# ---- Federated-learning privacy boundary ----
# Bank-local data must never be committed or shared.
ai_engine/data/banks/*/*
!ai_engine/data/banks/*/.gitkeep
# Trained models, checkpoints and run outputs are build artifacts
ai_engine/artifacts/*
!ai_engine/artifacts/.gitkeep
*.pt
*.pth
*.ckpt
*.parquet

# Local DB / OS / IDE
*.sqlite3
*.db
.DS_Store
.idea/
.vscode/
*.log

*.bak

*.bak

